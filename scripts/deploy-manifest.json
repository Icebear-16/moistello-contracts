{
  "network": "testnet",
  "admin_identity": "moistello-deployer",
  "contracts": [
    {
      "name": "circle",
      "wasm": "target/wasm32v1-none/release/circle.optimized.wasm",
      "install_only": true,
      "init_args": "",
      "dependencies": []
    },
    {
      "name": "treasury",
      "wasm": "target/wasm32v1-none/release/treasury.optimized.wasm",
      "install_only": false,
      "init_args": "--admin {ADMIN_PUBLIC}",
      "dependencies": []
    },
    {
      "name": "reputation_registry",
      "wasm": "target/wasm32v1-none/release/reputation_registry.optimized.wasm",
      "install_only": false,
      "init_args": "--admin {ADMIN_PUBLIC}",
      "dependencies": []
    },
    {
      "name": "circle_factory",
      "wasm": "target/wasm32v1-none/release/circle_factory.optimized.wasm",
      "install_only": false,
      "init_function": "init_with_config",
      "init_args": "--admin {ADMIN_PUBLIC} --fee_bps 50 --treasury {TREASURY_ID} --reputation_registry {REP_ID} --circle_wasm_hash {CIRCLE_WASM_HASH}",
      "dependencies": ["circle", "treasury", "reputation_registry"]
    }
  ]
}
